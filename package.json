{
  "name": "pragna2-desktop-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:clean": "bash scripts/dev-clean.sh",
    "dev:clean:win": "powershell -ExecutionPolicy Bypass -File scripts/dev-clean.ps1",
    "sync-version": "node scripts/sync-version.mjs",
    "release": "node scripts/release.mjs",
    "build": "node scripts/sync-version.mjs && tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:brand": "node scripts/tauri-with-brand.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint:platform": "node scripts/check-platform-abstraction.mjs",
    "sign:dev": "bash scripts/macos-dev-codesign.sh",
    "tauri:dev:signed": "cargo build --manifest-path src-tauri/Cargo.toml && bash scripts/macos-dev-codesign.sh && tauri dev",
    "bump:patch": "node scripts/bump-version.mjs patch && node scripts/sync-version.mjs",
    "bump:minor": "node scripts/bump-version.mjs minor && node scripts/sync-version.mjs"
  },
  "dependencies": {
    "@ag-ui/client": "^0.0.43",
    "@ag-ui/core": "^0.0.43",
    "@codemirror/lang-yaml": "^6.1.3",
    "@fabianlars/tauri-plugin-oauth": "^2.0.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@sgummalla-works/sketchon": "^0.5.0",
    "@tanstack/react-query": "^5.101.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-http": "^2.5.9",
    "@tauri-apps/plugin-opener": "^2",
    "@uiw/react-codemirror": "^4.25.10",
    "axios": "^1.17.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dagre": "^0.8.5",
    "dompurify": "^3.4.8",
    "js-yaml": "^4.2.0",
    "katex": "^0.16.47",
    "lucide-react": "^1.17.0",
    "pdfjs-dist": "^6.0.227",
    "radix-ui": "^1.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.17.0",
    "reactflow": "^11.11.4",
    "rxjs": "^7.8.1",
    "shadcn": "^4.11.0",
    "sonner": "^2.0.7",
    "streamdown": "^1.6.11",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "unist-util-visit": "^5.1.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/dagre": "^0.7.54",
    "@types/hast": "^3.0.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.9.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/coverage-istanbul": "^3.2.6",
    "jsdom": "^29.1.1",
    "msw": "^2.14.6",
    "sharp": "^0.35.1",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^3.2.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
