# ── e2e configuration ─────────────────────────────────────────────────────────
# Copy to `e2e/.env` and fill in. `e2e/.env` is gitignored (it holds the Auth0
# password + LLM key); this `.env.example` is the committed, documented surface.
# `playwright.config.ts` auto-loads `e2e/.env` (see helpers/loadEnv.ts), so once
# it's filled you just run `npm test` — no per-run `export`s, no hardcoding.
# Shell-exported vars still win, so CI / a one-off `E2E_FOO=… npm test` override
# the file without editing it.
#
# STANDING RULE: run e2e against an **Auth0** backend only — never local-auth.

# ── Frontend / Backend ─────────────────────────────────────────────────────────
# FE dev server (vite strictPort :1420). Boot it pointed at the BE under test:
#   VITE_API_BASE_URL=<BE>/api VITE_E2E_NO_STRICT_MODE=1 pnpm dev
E2E_FE_URL=http://localhost:1420
# Backend base URL the suite calls (auth/me, conversations, attachments…).
E2E_BE_URL=http://localhost:8181
# Optional: override the API root. Defaults to ${E2E_BE_URL}/api.
# E2E_API_BASE_URL=http://localhost:8181/api

# ── Database ───────────────────────────────────────────────────────────────────
# The DB the BE under test reads/writes. The psql helper reaches it via
# `docker exec <container> psql -U <user> -d <db>`; the create_pdf seeder reaches
# it by running INSIDE the BE container (E2E_BE_CONTAINER below).
E2E_PG_CONTAINER=nexus-kit-postgres   # container that runs Postgres
E2E_PG_DB=nexus_kit                   # database name
E2E_PG_USER=nexus_kit                 # role to connect as (throwaway stack: postgres)

# ── Seeding ────────────────────────────────────────────────────────────────────
# For the deterministic create_pdf cross-check (Scenarios 20/21): run the seeder
# INSIDE this BE container so it inherits the container's real DATABASE_URL +
# storage volume (nothing hardcoded). Leave UNSET to use the legacy host path
# (needs E2E_BE_REPO + a host-reachable Postgres via E2E_PG_HOST/PORT/USER/PASSWORD).
E2E_BE_CONTAINER=nexus-kit-api
# Backend repo root — only needed for the legacy HOST seeding path (uv run).
# E2E_BE_REPO=/abs/path/to/pragna2-api
# Host Postgres connection parts — only the legacy host seeding path uses these.
# E2E_PG_HOST=localhost
# E2E_PG_PORT=5433
# E2E_PG_PASSWORD=postgres-password

# ── Auth (Auth0 — required; local-auth is forbidden) ───────────────────────────
E2E_AUTH_MODE=auth0
E2E_AUTH0_DOMAIN=your-tenant.us.auth0.com
E2E_AUTH0_CLIENT_ID=your-spa-client-id
# Must equal the BE's AUTH0_AUDIENCE (e.g. https://api.example.com/nexus-kit).
E2E_AUTH0_AUDIENCE=https://api.example.com/<api>
E2E_AUTH0_USERNAME=test_user@example.com
E2E_AUTH0_PASSWORD=
# So DB seeders resolve the Auth0 user's row (match the token's email/name).
E2E_TEST_EMAIL=test_user@example.com
E2E_TEST_NAME=Test User

# ── LLM (provider + key, supplied per run) ─────────────────────────────────────
# The suite is model/provider-agnostic — it seeds ONE provider per run and picks
# whatever model is available. Never pin a model name.
E2E_PROVIDER=openai
# Provide the key for the chosen provider (and/or the generic E2E_LLM_API_KEY).
# E2E_LLM_API_KEY=
# E2E_OPENAI_API_KEY=
# E2E_ANTHROPIC_API_KEY=
# E2E_GOOGLE_API_KEY=
# Optional: pin the model-picker option by label regex (default: first available).
# E2E_MODEL_LABEL=
