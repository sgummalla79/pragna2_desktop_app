# ── Auth0 ────────────────────────────────────────────────────────────────────
# Auth0 tenant domain (no https://)
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com

# Auth0 SPA application Client ID
VITE_AUTH0_CLIENT_ID=your-client-id

# Auth0 API audience (the identifier of the API registered in Auth0)
VITE_AUTH0_AUDIENCE=https://api.example.com

# Localhost port POOL for the social-login loopback redirect (RFC 8252). The app
# binds the first free port; register EVERY port below as an Allowed Callback URL
# in Auth0 (http://localhost:<port>/callback for each).
VITE_OAUTH_LOOPBACK_PORTS=8788,8789,8790,8791

# ── FastAPI backend ───────────────────────────────────────────────────────────
# API root incl. /api. Dev: http://localhost:8000/api
VITE_API_BASE_URL=http://localhost:8000/api

# Absolute base for the AG-UI native chat surface (POST {base}/chat, /flows/*).
# The chat route prefix is brand-specific: the nexus-kit-api BE serves /api/pragna,
# the nexus-kit BE serves /api/nexus-kit. Leave unset to default to
# {VITE_API_BASE_URL}/pragna. (Legacy VITE_PRAGNA_BASE_URL is still honoured.)
# VITE_CHAT_API_BASE_URL=http://localhost:8000/api/pragna

# Minimum log level: debug | info | warn | error
VITE_LOG_LEVEL=debug

# App metadata
VITE_APP_NAME=Pragna
# App version is sourced from package.json at build (injected as __APP_VERSION__);
# it is intentionally NOT configured here so it cannot drift from the real release.
