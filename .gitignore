# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# TypeScript incremental build caches (regenerated by `tsc` / `tsc -b`).
*.tsbuildinfo

# Local environment (Auth0 / backend config). Commit .env.example, not .env.
.env
.env.*
!.env.example

# Build-time white-label brand overlay — a brander's own name/logo/icon/theme.
# NEVER committed: the repo ships only the committed defaults (stock Pragna) and
# the `branding.example/` template. See docs/specs/features/custom-branding.md.
/branding/
# Generated brand OS icons (from `branding/icon.png` via `tauri icon`).
/src-tauri/icons-brand/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Rust / Cargo
debug/
target/
**/*.rs.bk
*.pdb
**/mutants.out*/

# Test coverage reports (report-only; regenerated by vitest --coverage)
coverage/

# Claude Code personal/local settings — machine-specific runtime grants
# (e.g. permissions.additionalDirectories with absolute paths). The shared
# .claude/settings.json IS committed; this per-user override never is.
.claude/settings.local.json
